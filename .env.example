# ---- Copier ce fichier en .env et renseigner les valeurs ----

# Options pip passées aux builds Docker. Laisser vide en temps normal.
# Si un antivirus/proxy intercepte le TLS (ex. Avast Web Shield) et que pip échoue en
# CERTIFICATE_VERIFY_FAILED dans les containers :
# PIP_EXTRA_ARGS=--trusted-host pypi.org --trusted-host files.pythonhosted.org
PIP_EXTRA_ARGS=
# Même cause côté runtime (appels HTTPS des DAGs vers l'API) : générer docker/certs/ca-bundle.pem
# (certifi + certificat racine de l'intercepteur) puis :
# REQUESTS_CA_BUNDLE=/certs/ca-bundle.pem
REQUESTS_CA_BUNDLE=

# PostgreSQL (superuser + mots de passe des 3 bases crÃ©Ã©es Ã  l'init : airflow, mlflow, fraud)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
AIRFLOW_DB_PASSWORD=airflow
MLFLOW_DB_PASSWORD=mlflow
FRAUD_DB_PASSWORD=fraud

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change-me

# MLflow (vu depuis la machine hÃ´te : localhost ; dans Docker Airflow utilise http://mlflow:5000)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_NAME=fraud_detection
MLFLOW_MODEL_ALIAS=production

# Pipeline
FRAUD_API_URL=https://sdacelo-real-time-fraud-detection.hf.space/current-transactions
FRAUD_THRESHOLD=0.5
REPORT_TIMEZONE=Europe/Paris

# Notifications
DISCORD_WEBHOOK_URL=

# Ports exposés sur la machine hôte (à changer en cas de conflit avec un autre projet)
POSTGRES_HOST_PORT=5432
MLFLOW_HOST_PORT=5000
AIRFLOW_HOST_PORT=8080
DASHBOARD_HOST_PORT=8501
